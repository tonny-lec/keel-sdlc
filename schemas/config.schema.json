{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KEEL config v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "source_roots": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 16000
      },
      "minItems": 1,
      "maxItems": 1000
    },
    "exclude_dirs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 16000
      },
      "minItems": 0,
      "maxItems": 1000
    },
    "evidence_ttl_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2592000
    },
    "max_log_bytes": {
      "type": "integer",
      "minimum": 1024,
      "maximum": 10485760
    },
    "env_allowlist": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 16000
      },
      "minItems": 0,
      "maxItems": 1000
    },
    "checks": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "argv": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16000
            },
            "minItems": 1,
            "maxItems": 1000
          },
          "kind": {
            "type": "string",
            "enum": [
              "experiment",
              "test",
              "lint",
              "security",
              "review",
              "rollback",
              "observe"
            ]
          },
          "timeout_seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 86400
          },
          "cwd": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16000
          },
          "env": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "minLength": 0,
              "maxLength": 16000
            }
          }
        },
        "required": [
          "argv",
          "kind",
          "timeout_seconds",
          "cwd",
          "env"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "source_roots",
    "exclude_dirs",
    "evidence_ttl_seconds",
    "max_log_bytes",
    "env_allowlist",
    "checks"
  ],
  "additionalProperties": false
}
