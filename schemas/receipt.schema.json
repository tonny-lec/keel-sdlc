{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KEEL receipt v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "packet_digest": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16000,
      "pattern": "^[a-f0-9]{64}$"
    },
    "environment": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16000
    },
    "deployment_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16000
    },
    "outcome": {
      "type": "string",
      "enum": [
        "success",
        "failure"
      ]
    },
    "deployed_at": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16000
    },
    "actor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16000
    }
  },
  "required": [
    "schema_version",
    "packet_digest",
    "environment",
    "deployment_id",
    "outcome",
    "deployed_at",
    "actor"
  ],
  "additionalProperties": false
}
